# ==============================================================================
# Curiosity Environment Configuration Template
# Copy this file to .env and replace with your real secrets.
# NEVER commit your real .env file to Git!
# ==============================================================================

# --- Database Settings ---
# PostgreSQL (Neon Serverless, Supabase, Render, or Local Docker):
# You can paste the raw connection string copied straight from Neon Console.
# The backend automatically converts postgresql:// to postgresql+asyncpg://,
# handles ?sslmode=require, and optimizes -pooler endpoints.
DATABASE_URL=postgresql://neondb_owner:npg_your_password@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# SQLite Local Fallback (Used automatically when PostgreSQL is offline or unreachable):
FALLBACK_DATABASE_URL=sqlite+aiosqlite:///./curiosity_dev.db
AUTO_FALLBACK_DATABASE=true

# --- Caching & Redis Settings ---
# Redis Cache (Upstash Redis, Redis Cloud, or local Docker):
# In Upstash Console -> Details -> Connect -> redis-py / standard URL:
# Format: rediss://default:<UPSTASH_PASSWORD>@<your-db-id>.upstash.io:6379
# (Note the double 's' in rediss:// for TLS encryption, which Upstash requires)
REDIS_URL=rediss://default:your_upstash_password@ep-cool-fox-12345.upstash.io:6379
CACHE_TTL_SECONDS=86400
AUTO_FALLBACK_CACHE=true

# --- External API Keys ---
# NASA APOD API Key (Register free at https://api.nasa.gov/):
NASA_API_KEY=DEMO_KEY
HTTP_TIMEOUT_SECONDS=10.0

# --- Cron & Scheduled Automation (Upstash QStash) ---
# Secret token used by Upstash QStash to authenticate incoming webhook requests:
# Set this exact same secret in Upstash QStash -> Headers: "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=curiosity_dev_cron_secret_change_in_production

# When using external cron (Upstash QStash) in production, set this to false
# so multiple web containers don't duplicate aggregation runs:
ENABLE_INTERNAL_SCHEDULER=true

# Optional: Your Upstash QStash API Token (from Upstash Console -> QStash -> Details / Keys).
# If provided, enables programmatic schedule management via POST /api/v1/cron/setup-schedule
# QSTASH_TOKEN=your_qstash_api_token_here

# Optional: Public domain where your backend is hosted (e.g. https://my-app.onrender.com)
# Used by setup-schedule to construct destination webhook URL automatically:
# PUBLIC_BASE_URL=https://my-app.onrender.com

# Optional: Native Upstash QStash cryptographic signing keys (from Upstash Console)
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
